# REQUIRED. The SEC rejects requests without a descriptive User-Agent
# containing a real contact email. Use your own -- this is not optional.
SEC_USER_AGENT="Your Name your.email@domain.com"
SEC_RPS=6

START_YEAR=2018
END_YEAR=2024

# LLM (needed from Week 4)
LLM_PROVIDER=groq
OLLAMA_MODEL=qwen2.5:7b-instruct
GROQ_API_KEY=
# Groq retires models regularly. Run scripts/10_extract.py --list-models
# to see what your key can reach today.
GROQ_MODEL=openai/gpt-oss-120b

# The model every reported retrieval number was produced with. Changing it
# invalidates the numbers in EVALUATION.md -- bge-m3 is 1024d and 568M params
# against bge-small's 384d and 33M, so it is a different system, not a tweak.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker tier is a CLI choice, not an env var:
#   python scripts/09_eval_retrieval.py --reranker {fast,base,large}
# 'fast' (cross-encoder/ms-marco-MiniLM-L-6-v2) is the default and the model
# EVALUATION.md section 4 reports.
QDRANT_URL=http://localhost:6333
